# Copy this file to .env for local development, or to /data/fast-api/.env on the server.
# Never commit real secrets.

PORT=3000
TZ=Asia/Shanghai
SESSION_SECRET=<CHANGE_TO_A_LONG_RANDOM_STRING>
CRYPTO_SECRET=<CHANGE_TO_A_LONG_RANDOM_STRING>

# Leave SQL_DSN empty to use SQLite. For the Docker single-container deployment,
# the /data volume is persistent.
SQLITE_PATH=/data/fast-api.db?_busy_timeout=30000
# SQL_DSN=root:<MYSQL_PASSWORD>@tcp(<MYSQL_HOST>:3306)/fast-api

# Optional Redis. Leave empty for the single-container SQLite setup.
REDIS_CONN_STRING=

NODE_NAME=fast-api-node-1
MEMORY_CACHE_ENABLED=false
BATCH_UPDATE_ENABLED=true
ERROR_LOG_ENABLED=true
STREAMING_TIMEOUT=300

# Frontend dev server settings.
VITE_REACT_APP_SERVER_URL=http://localhost:3000
VITE_REACT_APP_BASE_PATH=/
